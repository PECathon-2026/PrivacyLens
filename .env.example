# PrivacyLens — Environment Variables
# Copy this file to .env and fill in the values you want to use.
# The application works fully in offline mock mode without any API key.

# ---------------------------------------------------------------------------
# Optional: External AI Model API Keys
# If not set, PrivacyLens uses the built-in offline mock reasoning engine.
# ---------------------------------------------------------------------------

# Google Gemini API key (get one at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Which provider to use when a key is present: "gemini" | "openai" | "mock"
# Defaults to "mock" when no key is provided.
AI_PROVIDER=mock

# ---------------------------------------------------------------------------
# Optional: Frontend API URL (Vite)
# Only needed if you run the React dev server and FastAPI on different ports.
# In production, FastAPI serves the built React app directly.
# ---------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
